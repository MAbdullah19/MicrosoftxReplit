# ── required ─────────────────────────────────────────────────────────
# Auto-provisioned by Replit Postgres
DATABASE_URL=

# 32 random bytes hex each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PEPPER_IDENTITY=
PEPPER_VOTE=
PEPPER_NET=
JOB_TOKEN=

# WebAuthn relying party. Bare host (no scheme/port) and full origin.
# In development on Replit these are derived from REPLIT_DEV_DOMAIN if unset.
RP_ID=
RP_ORIGIN=
RP_NAME=Attest

# ── optional — absence switches on a documented degraded mode ────────
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
GEMINI_API_KEY=
ANCHOR_CONTRACT_ADDRESS=
ANCHORER_PRIVATE_KEY=
VITE_ANCHOR_CONTRACT_ADDRESS=
RPC_URL=https://sepolia.base.org
VITE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=84532
VITE_EXPLORER_URL=https://sepolia.basescan.org
